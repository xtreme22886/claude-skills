# GitLab CI for {{PROJECT_NAME}}.
#
# Generated by /dev-team-init. Opinionated four-stage pipeline:
#   1. lint      — fast, fails the pipeline early
#   2. typecheck — fast, fails the pipeline early
#   3. test      — full suite
#   4. docs      — publishes docs/ops/ to Notion (only on default branch)
#
# All stages have the same image and a shared `before_script` so add new jobs
# without thinking too hard about setup.

stages:
  - lint
  - typecheck
  - test
  - docs

variables:
  PIP_CACHE_DIR: "$CI_PROJECT_DIR/.cache/pip"

.base:
  image: {{CI_IMAGE}}
  before_script:
    - {{CI_BEFORE_SCRIPT}}
  cache:
    paths:
      - .cache/pip/
      - node_modules/

lint:
  extends: .base
  stage: lint
  script:
    - {{LINT_CMD}}

typecheck:
  extends: .base
  stage: typecheck
  script:
    - {{TYPECHECK_CMD}}

test:
  extends: .base
  stage: test
  script:
    - {{TEST_CMD}}
  artifacts:
    when: always
    reports:
      junit: junit.xml
    paths:
      - coverage/

docs-publish:
  extends: .base
  stage: docs
  rules:
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
      changes:
        - docs/ops/**/*
  script:
    - pip install --quiet -r ~/.claude/skills/dev-team/adapter/requirements.txt || pip install --quiet notion-client tomli
    - python3 ~/.claude/skills/dev-team/adapter/notion_publish.py --project "{{NOTION_PROJECT_NAME}}" --docs-root docs/ops
  variables:
    # Set NOTION_TOKEN as a masked CI/CD variable in project settings.
    NOTION_TOKEN: $NOTION_TOKEN
